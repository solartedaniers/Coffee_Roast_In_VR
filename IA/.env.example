# Dirección y puerto donde escucha el servicio IA. 127.0.0.1 basta cuando el
# backend corre en el mismo host o en Docker Desktop (Windows/macOS). En un
# servidor Linux con el backend en Docker, ver "Servidor Ubuntu" en README.md.
AI_SERVER_ADDRESS=127.0.0.1
AI_SERVER_PORT=8082

# Misma base de datos PostgreSQL (con pgvector) que levanta docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5433/toasted_vr_db
DB_USERNAME=toasted_vr_user
DB_PASSWORD=

# Ollama corre en el host, fuera de Docker.
OLLAMA_BASE_URL=http://localhost:11434

# Modelo que redacta la retroalimentación ("ollama pull phi4-mini").
OLLAMA_FEEDBACK_MODEL=phi4-mini
OLLAMA_CONNECT_TIMEOUT_MILLIS=5000
# Si el equipo es lento y la retroalimentación llega vacía, súbelo; el
# backend espera AI_SERVICE_FEEDBACK_READ_TIMEOUT_MILLIS, que debe ser mayor.
OLLAMA_READ_TIMEOUT_MILLIS=120000
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_PREDICT=240

# Modelo de embeddings para los PDFs de rag-docs/ ("ollama pull nomic-embed-text").
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_CHUNK_SIZE_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
