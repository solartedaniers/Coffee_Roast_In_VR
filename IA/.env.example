# Dirección y puerto donde escucha el servicio IA. 127.0.0.1 basta cuando el
# backend corre en el mismo host o en Docker Desktop (Windows/macOS). En un
# servidor Linux con el backend en Docker, ver "Servidor Ubuntu" en README.md.
AI_SERVER_ADDRESS=127.0.0.1
AI_SERVER_PORT=8082

# Misma base de datos PostgreSQL (con pgvector) que levanta docker-compose.yml.
# Acepta el formato jdbc: de antes o el postgresql:// normal.
DB_URL=jdbc:postgresql://localhost:5433/toasted_vr_db
DB_USERNAME=toasted_vr_user
DB_PASSWORD=

# Proveedores que redactan la retroalimentación, en orden: si el primero
# falla se usa el siguiente. Valores posibles: groq, ollama.
FEEDBACK_PROVIDERS=groq,ollama
# Tiempo total de la cadena. Debe ser menor que el
# AI_SERVICE_FEEDBACK_READ_TIMEOUT_MILLIS del backend (130000).
FEEDBACK_TOTAL_TIMEOUT_MILLIS=125000
# Caché de retroalimentación en memoria (se pierde al reiniciar).
FEEDBACK_CACHE_TTL_SECONDS=86400
FEEDBACK_CACHE_MAX_ENTRIES=500

# Groq (https://console.groq.com). La llave va solo en IA/.env, que nunca se sube.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Alternativa más rápida: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CONNECT_TIMEOUT_MILLIS=5000
GROQ_READ_TIMEOUT_MILLIS=15000
GROQ_TEMPERATURE=0.4
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low

# Ollama corre en el host, fuera de Docker.
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de respaldo que redacta la retroalimentación ("ollama pull phi4-mini").
OLLAMA_FEEDBACK_MODEL=phi4-mini
OLLAMA_CONNECT_TIMEOUT_MILLIS=5000
OLLAMA_READ_TIMEOUT_MILLIS=120000
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_PREDICT=240

# Modelo de embeddings para los PDFs de rag-docs/ ("ollama pull nomic-embed-text").
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
RAG_CHUNK_SIZE_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
# Partición del texto: characters (ventana por caracteres) o sentences (limpia el PDF y junta
# frases completas). Cambiarla exige reindexar.
RAG_TEXT_SPLITTER=characters
RAG_MIN_CHUNK_CHARS=80
RAG_REPEATED_LINE_PAGE_RATIO=0.5
# Filtros sobre lo recuperado (0 o false = apagado).
RAG_DEDUPLICATE_CHUNKS=true
RAG_MAX_CHUNKS_PER_PAGE=1
RAG_CANDIDATE_POOL=20
