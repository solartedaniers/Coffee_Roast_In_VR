SERVER_PORT=8081

# Docker Compose PostgreSQL settings. The password must match the existing
# database volume when reusing an initialized local PostgreSQL instance.
POSTGRES_DB=toasted_vr_db
POSTGRES_USER=toasted_vr_user
POSTGRES_PASSWORD=

DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
VERIFICATION_CODE_LENGTH=6
# Email verification and password reset codes.
VERIFICATION_CODE_EXPIRATION_MINUTES=1
ONE_TIME_CODE_MAX_ATTEMPTS=5
ONE_TIME_CODE_MAX_RESENDS=3
ONE_TIME_CODE_RESEND_LOCK_MINUTES=5
# Minutes to set the new password after the reset code is verified.
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
# Email domain checks on sign-up. EMAIL_KNOWN_PROVIDERS must match validation.js.
EMAIL_KNOWN_PROVIDERS=gmail.com,hotmail.com,outlook.com,yahoo.com,icloud.com,hotmail.es,outlook.es,yahoo.es
EMAIL_MAX_TYPO_DISTANCE=1
EMAIL_DNS_CHECK_ENABLED=true
EMAIL_DNS_TIMEOUT_MILLIS=2000

# Sessions per page in the player history (RF016).
ROAST_HISTORY_PAGE_SIZE=10

# Server-side roast session validation (RF015). Must match RoastConstants.js.
ROAST_CHARGE_TEMPERATURE_MIN=0
ROAST_CHARGE_TEMPERATURE_MAX=750
ROAST_TARGET_TEMPERATURE_MIN=150
ROAST_TARGET_TEMPERATURE_MAX=230
ROAST_FINAL_TEMPERATURE_MAX=250
ROAST_RAW_TEMPERATURE_CEILING=186
ROAST_BURNED_TEMPERATURE_CEILING=217
ROAST_DEFECT_SCORE_MIN=5
ROAST_DEFECT_SCORE_MAX=50
ROAST_PERFECT_SCORE_MIN=0
ROAST_PERFECT_SCORE_MAX=100

# Local Ollama URL for running the backend directly on the host.
OLLAMA_BASE_URL=http://localhost:11434

# Docker containers reach an Ollama instance running on Windows through this URL.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Modelo de embeddings en Ollama usado solo para vectorizar los PDFs de
# rag-docs/ y las búsquedas de RAG (distinto de phi4-mini, que sigue siendo
# el que redacta el feedback). Requiere "ollama pull nomic-embed-text" antes
# de correr la ingesta en POST /api/v1/admin/rag/ingest.
RAG_EMBEDDING_MODEL=nomic-embed-text

# Base64-encoded key used to sign JWTs. Always provide a private value.
APP_JWT_SECRET=

# Access token lifetime in seconds (10 minutes).
APP_JWT_EXPIRATION_SECONDS=600

# Refresh token lifetime in hours, counted from its last use (1 day).
APP_JWT_REFRESH_EXPIRATION_HOURS=24

# Password and username rules shared by registration, profile and password reset.
PASSWORD_MIN_LENGTH=8
# BCrypt only processes 72 bytes; do not raise this value.
PASSWORD_MAX_LENGTH=72
USERNAME_MIN_LENGTH=4
USERNAME_MAX_LENGTH=20

# Required for permanent Unity access-code protection. Set these values only
# in the local .env file or deployment secret manager; do not commit them.
UNITY_CODE_HMAC_PEPPER=
UNITY_CODE_ENCRYPTION_KEY=

# Optionally create an administrator at startup when the email and username
# do not exist. Keep this disabled unless explicitly needed.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=Admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=your_admin_password
