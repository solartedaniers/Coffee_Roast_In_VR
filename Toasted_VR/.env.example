SERVER_PORT=8081
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRATION_MINUTES=2

# URL local de Ollama (retroalimentación con phi4-mini). Deja el default si
# corres "ollama serve" en la misma máquina que el backend.
OLLAMA_BASE_URL=http://localhost:11434

# Clave para firmar los JWT de sesión. Tiene un valor por defecto de
# desarrollo si no se configura; en produccion debe reemplazarse por una
# clave propia y secreta.
APP_JWT_SECRET=your_own_secret_key

# Duracion del JWT en segundos antes de expirar. Por defecto 3600 (1 hora)
# si no se configura.
APP_JWT_EXPIRATION_SECONDS=3600

# Crea un usuario administrador automaticamente al arrancar el backend, solo
# si no existe ya un usuario con ese email o username. Por defecto
# deshabilitado (false) y sin valores si no se configura.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=Admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=your_admin_password