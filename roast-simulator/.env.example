# Copiar como .env (npm start lo carga si existe). Ninguno es secreto.
# Solo el backend llama al simulador, por eso escucha en 127.0.0.1.
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=8083
# Segundos sin consultas tras los que se borra una simulación abandonada.
SIMULATION_IDLE_TIMEOUT_SECONDS=120
# Ticks que guarda cada simulación para que el cliente recupere los que se perdió (los más viejos se
# descartan). 3600 alcanza para una hora simulada y ocupa cerca de 1,5 MB.
SIMULATION_MAX_STORED_TICKS=3600
# Tamaño máximo del cuerpo de un pedido.
SIMULATOR_MAX_BODY_BYTES=16384
